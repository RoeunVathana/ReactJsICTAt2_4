import axios from "axios";

const request = async (path = "", method = "GET", data = {}) => {
  let headers = {"Content-Type": "application/json",};
  try {
    const res = await axios({
      method,
      url:path,
      data,
      headers,
    });

    return res.data;
  } catch (error) {
    console.log(error);
  }
};

export default request;